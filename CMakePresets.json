{
  "version": 3,
  "configurePresets": [
    {
      "name": "win64",
      "displayName": "Windows x64 (Linux: clang-cl + xwin)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win64",
      "toolchainFile": "${sourceDir}/cmake/clang-cl-xwin.cmake",
      "cacheVariables": {
        "SF_ARCH": "x86_64",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "win64-msvc",
      "displayName": "Windows x64 (Windows: MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win64",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "displayName": "Linux native (launcher + portable code)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "win64", "configurePreset": "win64" },
    { "name": "win64-msvc", "configurePreset": "win64-msvc" },
    { "name": "linux", "configurePreset": "linux" }
  ],
  "testPresets": [
    { "name": "win64", "configurePreset": "win64", "output": { "outputOnFailure": true } },
    { "name": "win64-msvc", "configurePreset": "win64-msvc", "output": { "outputOnFailure": true } },
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } }
  ]
}
