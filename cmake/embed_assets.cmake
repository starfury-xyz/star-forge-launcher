# Writes OUT, a C++ file holding every file under UI_DIR (as "<path>") and ICONS_DIR (as
# "icons/<path>") as sf::app::Asset entries, for assets.hpp.
# Run as: cmake -DOUT=... -DUI_DIR=... -DICONS_DIR=... -P embed_assets.cmake

set(DIRS "=${UI_DIR}" "icons=${ICONS_DIR}")
set(entries "")
set(arrays "")
set(n 0)
foreach(spec IN LISTS DIRS)
    string(FIND "${spec}" "=" eq)
    string(SUBSTRING "${spec}" 0 ${eq} prefix)
    math(EXPR from "${eq} + 1")
    string(SUBSTRING "${spec}" ${from} -1 dir)
    file(GLOB_RECURSE files RELATIVE "${dir}" "${dir}/*")
    list(SORT files)
    foreach(rel IN LISTS files)
        get_filename_component(ext "${rel}" LAST_EXT)
        string(TOLOWER "${ext}" ext)
        if(ext STREQUAL ".html")
            set(mime "text/html; charset=utf-8")
        elseif(ext STREQUAL ".js")
            set(mime "text/javascript; charset=utf-8")
        elseif(ext STREQUAL ".css")
            set(mime "text/css; charset=utf-8")
        elseif(ext STREQUAL ".json")
            set(mime "application/json")
        elseif(ext STREQUAL ".svg")
            set(mime "image/svg+xml")
        elseif(ext STREQUAL ".png")
            set(mime "image/png")
        elseif(ext STREQUAL ".ico")
            set(mime "image/vnd.microsoft.icon")
        elseif(ext STREQUAL ".woff2")
            set(mime "font/woff2")
        else()
            set(mime "application/octet-stream")
        endif()
        file(READ "${dir}/${rel}" hex HEX)
        string(LENGTH "${hex}" len)
        math(EXPR size "${len} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(APPEND arrays "static const unsigned char a${n}[] = {${bytes}0};\n")
        if(prefix STREQUAL "")
            set(path "${rel}")
        else()
            set(path "${prefix}/${rel}")
        endif()
        string(APPEND entries "    {\"${path}\", \"${mime}\", a${n}, ${size}},\n")
        math(EXPR n "${n} + 1")
    endforeach()
endforeach()

set(text "// Generated by cmake/embed_assets.cmake; do not edit.\n\n#include <cstring>\n\n#include \"app/assets.hpp\"\n\nnamespace sf::app {\n\nnamespace {\n${arrays}\nconst Asset kAssets[] = {\n${entries}};\n\n}  // namespace\n\nconst Asset* find_asset(const std::string& path) {\n    for (const Asset& a : kAssets)\n        if (path == a.path) return &a;\n    return nullptr;\n}\n\n}  // namespace sf::app\n")
file(WRITE "${OUT}" "${text}")
